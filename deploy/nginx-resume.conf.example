# Replace the hostname; start with HTTP only to validate DNS and issue a certificate.
# Install as a NEW site, never replace the existing nginx.conf or default site.
server {
    listen 80;
    server_name resume.example.ai;
    client_max_body_size 50m;
    location / {
        proxy_pass http://127.0.0.1:18766;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
