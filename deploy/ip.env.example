# Public IP HTTP testing; no domain needed. Contains no secrets.
# Set the actual server IPv4 address before starting.
RESUME_PUBLIC_ORIGIN=http://203.0.113.10
RESUME_HTTP_PORT=80
# Browser origins omit :80. For a custom port, include it in the origin above.
RESUME_IMAGE=resume-workflow:2026.10.04-3
RESUME_DATA_PATH=/srv/resume/data
RESUME_APP_ENV_FILE=./deploy/app.env
RESUME_APP_CPUS=2
RESUME_APP_MEMORY=2g
