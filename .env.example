AGENT_API_KEY=replace-with-your-key
AGENT_BASE_URL=
AGENT_MODEL=replace-with-your-model
# 支持推理强度的模型可设置；不支持时留空。
AGENT_REASONING_EFFORT=medium
# RESUME_DATA_DIR=/absolute/path/to/persistent/data

# 公开部署时填写浏览器访问的完整来源（不含路径），并启用 HTTPS Cookie。
RESUME_PUBLIC_ORIGIN=
RESUME_COOKIE_SECURE=false
# 短信默认关闭。开通阿里云短信、审核签名和验证码模板后再填写。
# 先安装可选依赖：python -m pip install -r requirements-sms.txt
RESUME_SMS_PROVIDER=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
RESUME_SMS_SIGN_NAME=
# 模板变量使用 code，例如：您的验证码为 ${code}。
RESUME_SMS_TEMPLATE_CODE=
RESUME_SMS_HOURLY_LIMIT=100
