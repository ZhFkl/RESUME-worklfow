AGENT_API_KEY=replace-with-your-key
AGENT_BASE_URL=
AGENT_MODEL=replace-with-your-model
# 支持推理强度的模型可设置；不支持时留空。
AGENT_REASONING_EFFORT=medium
# RESUME_DATA_DIR=/absolute/path/to/persistent/data

# 公开部署时填写浏览器访问的完整来源（不含路径），并启用 HTTPS Cookie。
RESUME_PUBLIC_ORIGIN=
RESUME_COOKIE_SECURE=false
# 邮箱验证码注册：配置支持 TLS 的 SMTP 服务。未配置时已有账号仍可登录，新注册暂不可用。
# 使用发信邮箱的 SMTP 授权码/API SMTP 密钥；不要把真实凭据提交 Git。
RESUME_SMTP_HOST=
RESUME_SMTP_PORT=465
# ssl（通常 465）或 starttls（通常 587）；不支持明文连接。
RESUME_SMTP_SECURITY=ssl
RESUME_SMTP_USERNAME=
RESUME_SMTP_PASSWORD=
# 只填完整邮箱地址，不带显示名称，例如 no-reply@resumeworkflow.com。
RESUME_EMAIL_FROM=

# 阿里云号码认证（不是普通短信服务）：配置后启用手机注册、登录及绑定。
RESUME_SMS_PROVIDER=aliyun-pnvs
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
RESUME_SMS_SIGN_NAME=恒创联众
RESUME_SMS_TEMPLATE_CODE=100001
